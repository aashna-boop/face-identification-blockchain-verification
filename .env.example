# Copy this file to .env and fill in your own keys. Never commit .env.

# Get a free key at https://api.imgbb.com/ (used only to briefly host your
# own input photo at a public URL so SerpApi's Google Lens API can fetch it;
# uploads auto-expire after IMGBB_EXPIRATION_SECONDS).
IMGBB_API_KEY= 70efcd82d6ba4dfc469860d30d814f11

# Get a free key at https://serpapi.com/manage-api-key (free plan: 100
# searches/month, no card required). Used for the Google Lens reverse-image
# search step.
SERPAPI_API_KEY= 0763e457b66f66cc1cf6ad1eeec954a84ffcf65b435c3d266bb56ec75cf506d3

# Seconds before the temporary imgbb hosted copy of your photo self-deletes.
IMGBB_EXPIRATION_SECONDS=600

# DeepFace settings. "opencv" needs no extra downloads; "retinaface" is more
# accurate but requires `pip install retina-face`.
FACE_MODEL=Facenet512
FACE_DETECTOR=opencv

# Local Hardhat JSON-RPC endpoint (started with: npx hardhat node)
CHAIN_RPC_URL=http://127.0.0.1:8545
